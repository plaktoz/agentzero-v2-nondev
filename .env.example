# Unified Content Agent System - Environment Variables

# Required: Anthropic API Key for Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI API Key (for multi-provider support in Phase 2)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Google API Key for Gemini (for multi-provider support in Phase 2)
# GOOGLE_API_KEY=your_google_api_key_here

# Optional: System Configuration
# UCAS_LOG_LEVEL=INFO
# UCAS_MAX_AGENTS=5
